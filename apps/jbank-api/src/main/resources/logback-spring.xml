<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml" />

  <!-- 표준 console-appender.xml을 include하면 구조화 로깅 프로퍼티가 반영되지 않아
       StructuredLogEncoder로 직접 정의한다(Spring Boot 3.4+). -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
      <format>ecs</format>
    </encoder>
  </appender>

  <!-- local/dev에서만 Loki로 직접 push한다. Promtail 컨테이너·공유 볼륨보다 단순하다. -->
  <springProfile name="local,dev">
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
      <http>
        <url>http://localhost:3100/loki/api/v1/push</url>
      </http>
      <format>
        <label>
          <pattern>app=jbank-api,level=%level</pattern>
        </label>
        <message>
          <pattern>level=%level traceId=%X{traceId} logger=%logger{36} - %message%n%ex</pattern>
        </message>
        <sortByTime>true</sortByTime>
      </format>
    </appender>

    <root level="INFO">
      <appender-ref ref="LOKI" />
    </root>
  </springProfile>

  <root level="INFO">
    <appender-ref ref="CONSOLE" />
  </root>
</configuration>
